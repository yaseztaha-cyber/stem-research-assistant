# Copy to .env and fill secrets — never commit .env
SECRET_KEY=change-me-to-random-secret
DATABASE_URL=sqlite:///../storage/app.db
# LLM
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Embeddings
EMBEDDING_PROVIDER=tfidf
# tfidf | dense | openai
DENSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Retrieval v0.2
RETRIEVAL_TOP_K=8
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
TOP_K_RETRIEVAL=30
TOP_K_RERANK=8
MMR_LAMBDA=0.7
RERANKER_PROVIDER=simple
# simple | cross_encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GROUNDING_THRESHOLD=0.6
CITATION_THRESHOLD=0.5
DOCUMENT_PARSER=layout_aware
# pypdf | layout_aware
EQUATION_PARSER=advanced
# regex | advanced
